# Supabase backend (recommended)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional legacy REST backend. Leave empty when using Supabase.
EXPO_PUBLIC_API_URL=

# Google Maps API Keys (build-time, no EXPO_PUBLIC_ prefix)
# See SETUP_GOOGLE_CLOUD.md for detailed instructions
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Google OAuth 2.0 Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Prembly NIN Verification (optional)
EXPO_PUBLIC_PREMBLY_APP_ID=
EXPO_PUBLIC_PREMBLY_API_KEY=
EXPO_PUBLIC_USE_LIVE_NIN=false
